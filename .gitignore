# Secrets (portal token, API keys)
.env
.env.*
!.env.example

# Portal data: only data/portal is tracked, so we can see what changed
data/*
!data/portal/

# Agent config is shared in this repo (overrides a global .claude ignore);
# personal settings stay local
!.claude/
!.claude/**
.claude/settings.local.json

# Tooling
.DS_Store
__pycache__/
.venv/
node_modules/
dist/

# Local copy of portal data (confidential)
soony-data/

# Agent skills
.claude/
