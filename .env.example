# Copy to .env and fill in. .env is gitignored; never commit real values.

# Team token from the Soony portal: Settings > API token
SOONY_PORTAL_TOKEN=

# Portal base URL (API lives under /api/v1)
SOONY_PORTAL_URL=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net

# --- Watcher (src/ask_soony) ---
# LLM: anthropic | openai | llamacpp | none (poll and store only)
ASK_LLM_PROVIDER=anthropic
# Defaults: claude-opus-5-5 for anthropic. For llama.cpp: the model name the server reports.
ASK_LLM_MODEL=
# Claude (default backend): key from https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=
# Key for other providers (openai). Leave empty for anthropic (uses ANTHROPIC_API_KEY) and llama.cpp.
ASK_LLM_API_KEY=
# OpenAI-compatible server, e.g. http://localhost:8080/v1 for llama-server --jinja
ASK_LLM_BASE_URL=
# Claude effort: low | medium | high | xhigh | max
ASK_LLM_EFFORT=medium
ASK_INTERVAL_SECONDS=300
ASK_DATA_DIR=data/store
# Comma-separated: console, macos, discord, webhook
ASK_NOTIFIERS=console,macos
ASK_DISCORD_WEBHOOK_URL=
ASK_WEBHOOK_URL=
# Findings at or above this severity are pushed: info | low | medium | high | critical
ASK_NOTIFY_MIN_SEVERITY=high

# Dashboard (ask-soony dashboard / serve): basic auth password, any user name
ASK_DASHBOARD_PASSWORD=
ASK_DASHBOARD_PORT=8765

# Alerts and calls (ask-soony alert / serve)
ASK_ALERT_POLICY=data/alert-policy.json
# dry_run | twilio | elevenlabs
ASK_CALL_PROVIDER=dry_run
# Real alert emails through the mail account above: on | off
ASK_ALERT_EMAIL=off
ASK_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# OpenAI realtime calls (ASK_CALL_PROVIDER=openai); webhook event realtime.call.incoming -> <ASK_PUBLIC_URL>/hooks/openai
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# server (volume threshold, filters background) | semantic
OPENAI_TURN_DETECTION=server
OPENAI_VAD_THRESHOLD=0.8

# Launch alerts in Microsoft Teams: a "Workflows" incoming webhook of a channel
# (Teams channel -> Workflows -> "Post to a channel when a webhook request is received").
# Start the server with ASK_TEAMS=on to post new red/amber inbox cards; replies follow up.
ASK_TEAMS_WEBHOOK=
# Public address of the app for the card buttons
ASK_APP_URL=https://app.example.com
